---
import Layout from '../layouts/Layout.astro';
---

<Layout title="LTAW Prácticas - Portfolio">
	<main class="min-h-screen bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 flex items-center justify-center p-4">
		<div class="max-w-4xl w-full">
			<div class="bg-white/10 backdrop-blur-lg rounded-2xl shadow-2xl p-8 md:p-12 border border-white/20">
				<!-- Header -->
				<div class="text-center mb-8">
					<h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
						Prácticas LTAW
					</h1>
					<p class="text-lg md:text-xl text-gray-300 leading-relaxed">
						Portfolio de proyectos de backend desarrollados con Node.js durante la asignatura 
						Laboratorio de Tecnologías Audiovisuales en la Web. Esta infraestructura dockerizada 
						integra múltiples aplicaciones con diferentes tecnologías y arquitecturas.
					</p>
				</div>

				<!-- Projects Grid -->
				<div class="grid md:grid-cols-2 gap-6 mt-12">
					<!-- P2 - Tienda -->
					<div class="bg-white/5 rounded-xl p-6 border border-white/10 hover:bg-white/10 transition-all">
						<h2 class="text-2xl font-bold text-white mb-3">
							📦 Tienda Online
						</h2>
						<p class="text-gray-300 mb-4 text-sm">
							E-commerce con Server-Side Rendering, carrito de compras y generación 
							de documentos con IA. Stack: React, Express, Babel.
						</p>
						<a 
							href="http://localhost:8001"
							target="_blank"
							rel="noopener noreferrer"
							class="block w-full bg-purple-600 hover:bg-purple-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors text-center"
						>
							Acceder a la Tienda →
						</a>
						<p class="text-xs text-gray-400 mt-2 text-center">
							Puerto: 8001
						</p>
					</div>

					<!-- P3 - Game -->
					<div class="bg-white/5 rounded-xl p-6 border border-white/10 hover:bg-white/10 transition-all">
						<h2 class="text-2xl font-bold text-white mb-3">
							🎮 Kill Two Birds
						</h2>
						<p class="text-gray-300 mb-4 text-sm">
							Juego multiplayer en tiempo real con WebSockets. Conecta con otros 
							jugadores y compite. Stack: Express, Socket.IO, Canvas.
						</p>
						<a 
							href="http://localhost:9000"
							target="_blank"
							rel="noopener noreferrer"
							class="block w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors text-center"
						>
							Jugar Ahora →
						</a>
						<p class="text-xs text-gray-400 mt-2 text-center">
							Puerto: 9000
						</p>
					</div>
				</div>

				<!-- Wiki Link -->
				<div class="mt-6">
					<a 
						href="/wiki/Home" 
						class="block bg-gradient-to-r from-purple-600/20 to-indigo-600/20 rounded-xl p-6 border border-purple-500/30 hover:border-purple-500/50 transition-all"
					>
						<div class="flex items-center justify-between">
							<div>
								<h3 class="text-xl font-bold text-white mb-2">
									📚 Documentación y Wiki
								</h3>
								<p class="text-gray-300 text-sm">
									Explora la documentación técnica, manuales de usuario y recursos de cada práctica
								</p>
							</div>
							<span class="text-3xl">→</span>
						</div>
					</a>
				</div>

				<!-- Footer Info -->
				<div class="mt-8 pt-6 border-t border-white/10 text-center">
					<p class="text-sm text-gray-400">
						🐳 Infraestructura dockerizada con Docker Compose
					</p>
				</div>
			</div>
		</div>
	</main>
</Layout>
